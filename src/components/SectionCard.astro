---
import { Icon } from '@astrojs/starlight/components';
interface Props {
	title: string;
	description: string;
	href: string;
	icon: string;
	hue: string;
}
const { title, description, href, icon, hue } = Astro.props;
---

<a class="section-card" href={href} style={`--card-hue: ${hue}`}>
	<span class="icon-tile"><Icon name={icon as any} size="1.5rem" /></span>
	<span class="body">
		<span class="title">{title}</span>
		<span class="desc">{description}</span>
	</span>
	<span class="arrow" aria-hidden="true"><Icon name="right-arrow" size="1.1rem" /></span>
</a>

<style>
	.section-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: linear-gradient(
			160deg,
			color-mix(in srgb, var(--card-hue) 12%, transparent),
			transparent 65%
		);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
	}
	.section-card:hover {
		border-color: var(--card-hue);
		box-shadow: var(--sl-shadow-md);
	}
	.icon-tile {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.65rem;
		color: var(--card-hue);
		background: color-mix(in srgb, var(--card-hue) 18%, transparent);
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	.title {
		font-size: var(--sl-text-lg);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.desc {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.arrow {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		color: var(--sl-color-gray-3);
		transition: transform 0.15s ease, color 0.15s ease;
	}
	.section-card:hover .arrow {
		color: var(--card-hue);
		transform: translateX(3px);
	}
	.section-card:hover .title {
		color: var(--card-hue);
	}
</style>
