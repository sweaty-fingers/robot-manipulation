---
import Default from '@astrojs/starlight/components/Header.astro';
import { sections } from '../config/sections';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { pathname } = Astro.url;
---

<div class="original-header-row">
	<Default />
</div>
<nav class="section-tabs" aria-label="섹션">
	<ul>
		{
			sections.map((s) => (
				<li>
					<a href={base + s.href} aria-current={pathname.includes(`/${s.match}/`) ? 'page' : undefined}>
						{s.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	/*
	 * Starlight's own <Header> content has `height: 100%` baked into its
	 * internal `.header` div, so it will swallow this entire fixed-position
	 * box (sized by --sl-nav-height, which custom.css bumps up to make room
	 * for the tab row below). Wrapping it in a sibling with an EXPLICIT,
	 * independent height stops it from doing that — otherwise the tab row
	 * gets pushed below the box and overlaps the page content that starts
	 * right where the box is supposed to end.
	 */
	.original-header-row {
		height: var(--sl-nav-height-original, 3.5rem);
	}

	@media (min-width: 50rem) {
		.original-header-row {
			height: var(--sl-nav-height-original, 4rem);
		}
	}

	.section-tabs {
		display: none;
		height: var(--section-tabs-height, 2.5rem);
		border-bottom: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg-nav);
	}

	@media (min-width: 50rem) {
		.section-tabs {
			display: flex;
			align-items: center;
		}
	}

	.section-tabs ul {
		margin: 0;
		padding: 0 var(--sl-nav-pad-x);
		display: flex;
		gap: 0.25rem;
		list-style: none;
		max-width: 1200px;
	}

	.section-tabs a {
		display: inline-block;
		padding: 0.4rem 0.75rem;
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		transition: background-color 0.12s ease, color 0.12s ease;
	}

	.section-tabs a:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}

	.section-tabs a[aria-current='page'] {
		color: var(--sl-color-text-invert);
		background-color: var(--sl-color-accent);
	}
</style>
