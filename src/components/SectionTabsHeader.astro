---
import Default from '@astrojs/starlight/components/Header.astro';

const sections = [
	{ label: '개념', match: 'concepts', href: 'concepts/manipulation-basics/' },
	{ label: '시뮬레이션', match: 'simulation', href: 'simulation/drake-mujoco-overview/' },
	{ label: '학습 & 검증', match: 'training', href: 'training/model-training/' },
	{ label: '데이터 파이프라인', match: 'data-pipeline', href: 'data-pipeline/rerun-overview/' },
	{ label: '가이드', match: 'guides', href: 'guides/setup/' },
	{ label: '예제', match: 'examples', href: 'examples/example-01-reach/' },
];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { pathname } = Astro.url;
---

<Default>
	<slot />
</Default>
<nav class="section-tabs" aria-label="섹션">
	<ul>
		{
			sections.map((s) => (
				<li>
					<a href={base + s.href} aria-current={pathname.includes(`/${s.match}/`) ? 'page' : undefined}>
						{s.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.section-tabs {
		display: none;
		border-bottom: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg-nav);
	}

	@media (min-width: 50rem) {
		.section-tabs {
			display: block;
		}
	}

	.section-tabs ul {
		margin: 0;
		padding: 0 var(--sl-nav-pad-x);
		display: flex;
		gap: 1.5rem;
		list-style: none;
		max-width: 1200px;
	}

	.section-tabs a {
		display: inline-block;
		padding: 0.6rem 0.1rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}

	.section-tabs a:hover {
		color: var(--sl-color-white);
	}

	.section-tabs a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		border-bottom-color: var(--sl-color-accent);
	}
</style>
