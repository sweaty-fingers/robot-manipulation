---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { sections } from '../config/sections';

// Desktop shows a top tab per section (SectionTabsHeader.astro), so the left
// sidebar only needs the active section's pages, not every group at once.
// Mobile has no top tabs, so it gets a small pill switcher here instead.

const { sidebar } = Astro.locals.starlightRoute;
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const activeSection = sections.find((s) => pathname.includes(`/${s.match}/`));

function groupMatchesSection(entry: (typeof sidebar)[number], matchSegment: string): boolean {
	return (
		entry.type === 'group' &&
		entry.entries.some((e) => e.type === 'link' && e.href.includes(`/${matchSegment}/`))
	);
}

const activeGroup = activeSection ? sidebar.find((g) => groupMatchesSection(g, activeSection.match)) : undefined;
const scopedEntries = activeGroup && activeGroup.type === 'group' ? activeGroup.entries : sidebar;
---

<nav class="mobile-section-switcher" aria-label="섹션">
	<ul>
		{
			sections.map((s) => (
				<li>
					<a href={base + s.href} aria-current={activeSection?.match === s.match ? 'page' : undefined}>
						{s.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<SidebarPersister><SidebarSublist sublist={scopedEntries} /></SidebarPersister>

<div class="md:sl-hidden"><MobileMenuFooter /></div>

<style>
	.mobile-section-switcher {
		display: block;
		margin-bottom: 1rem;
	}

	@media (min-width: 50rem) {
		.mobile-section-switcher {
			display: none;
		}
	}

	.mobile-section-switcher ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.mobile-section-switcher a {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		text-decoration: none;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}

	.mobile-section-switcher a[aria-current='page'] {
		background-color: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
		color: var(--sl-color-accent);
	}
</style>
